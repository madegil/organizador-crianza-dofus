---
/** Enlace contextual de la guía a una herramienta del sitio */
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a
  href={href}
  class="flex items-start gap-2.5 p-3 rounded-xl bg-blue-50/80 border border-blue-200/80 text-blue-950 hover:bg-blue-100/80 transition text-[13px] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
>
  <span aria-hidden="true" class="mt-px text-blue-600 font-bold">→</span>
  <span><strong class="font-bold text-blue-900">{label}.</strong> <slot /></span>
</a>
