---
/** Enlace contextual de la guía a una herramienta del sitio */
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a
  href={href}
  class="group flex items-start gap-2.5 p-3 rounded-xl bg-blue-50 border border-blue-200 text-blue-950 hover:bg-blue-100 hover:border-blue-300 hover:-translate-y-0.5 text-[13px]"
>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-0.5 w-4 h-4 shrink-0 text-blue-600 duration-300 ease-resorte group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
  <span><strong class="font-bold text-blue-900">{label}.</strong> <slot /></span>
</a>
