---
import { GUIDE_ITEMS, type GuideItemId } from '../../data/guideItems';

/** Una celda puede ser texto (admite **negrita**), un número o un objeto del juego con su imagen */
type Cell = string | number | { item: GuideItemId; text?: string };

interface Props {
  head: string[];
  rows: Cell[][];
  /** Descripción breve para lectores de pantalla */
  caption?: string;
  /** Atributo data-* opcional por fila (p. ej. el mes en el Almanax) */
  rowData?: (string | number)[];
}
const { head, rows, caption, rowData } = Astro.props;
// En móvil, las tablas de 3 o más columnas se muestran como fichas apiladas
const stack = head.length >= 3;

const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/** Convierte **texto** en negrita, sin permitir otro HTML */
const rich = (c: string | number) => escape(String(c)).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<table class:list={['guide-table w-full text-left text-[13px] border-collapse', { 'gt-stack': stack }]}>
  {caption && <caption class="sr-only">{caption}</caption>}
  <thead>
    <tr class="border-b border-slate-200">
      {head.map((h) => <th scope="col" class="py-2 pr-3 font-bold text-slate-900 align-bottom">{h}</th>)}
    </tr>
  </thead>
  <tbody>
    {
      rows.map((r, i) => (
        <tr class="border-b border-slate-100 last:border-0 align-middle" data-row={rowData?.[i]}>
          {r.map((c, j) =>
            typeof c === 'object' ? (
              j === 0 ? (
                <th scope="row" class="py-2 pr-3 font-semibold text-slate-900 min-w-[7rem]">
                  <span class="celda-objeto" title={GUIDE_ITEMS[c.item].name}>
                    <img src={GUIDE_ITEMS[c.item].img} alt="" width="36" height="36" loading="lazy" />
                    <span>{c.text ?? GUIDE_ITEMS[c.item].name}</span>
                  </span>
                </th>
              ) : (
                <td class="py-2 pr-3" data-label={head[j]}>
                  <span class="gt-valor">
                    <span class="celda-objeto" title={GUIDE_ITEMS[c.item].name}>
                      <img src={GUIDE_ITEMS[c.item].img} alt="" width="36" height="36" loading="lazy" />
                      <span>{c.text ?? GUIDE_ITEMS[c.item].name}</span>
                    </span>
                  </span>
                </td>
              )
            ) : j === 0 ? (
              <th scope="row" class="py-2 pr-3 font-semibold text-slate-900 min-w-[7rem]" set:html={rich(c)} />
            ) : (
              <td class="py-2 pr-3" data-label={head[j]}>
                <span class="gt-valor" set:html={rich(c)} />
              </td>
            )
          )}
        </tr>
      ))
    }
  </tbody>
</table>

<style is:global>
  .celda-objeto {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .celda-objeto img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 1px 0 rgb(0 0 0 / 0.2));
  }
  @media (max-width: 639px) {
    .gt-stack thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .gt-stack,
    .gt-stack tbody,
    .gt-stack tr,
    .gt-stack th,
    .gt-stack td {
      display: block;
    }
    .gt-stack tbody {
      display: grid;
      gap: 0.5rem;
    }
    .gt-stack tr {
      border: 1px solid #dfcb9f;
      border-radius: 0.75rem;
      padding: 0.625rem 0.75rem 0.375rem;
    }
    .gt-stack tr:last-child {
      border-width: 1px;
    }
    /* Cabecera de la ficha: nombre (y objeto) separado de los datos */
    .gt-stack th[scope='row'] {
      padding: 0 0 0.5rem;
      margin-bottom: 0.125rem;
      min-width: 0;
      font-size: 15px;
      line-height: 1.3;
      border-bottom: 1px solid #ead9b4;
    }
    /* Cada dato: etiqueta a la izquierda, valor a la derecha en un solo bloque */
    .gt-stack td {
      display: grid;
      grid-template-columns: minmax(6.5rem, 40%) minmax(0, 1fr);
      column-gap: 0.75rem;
      align-items: baseline;
      padding: 0.45rem 0;
      line-height: 1.4;
    }
    .gt-stack td + td {
      border-top: 1px dashed #ead9b4;
    }
    .gt-stack td::before {
      content: attr(data-label);
      color: #5e4a30;
      font-weight: 600;
      font-size: 12px;
      line-height: 1.35;
      text-wrap: balance;
    }
    .gt-stack .gt-valor {
      min-width: 0;
      overflow-wrap: anywhere;
      text-wrap: pretty;
    }
    /* Con objeto (icono + nombre), alinear por el centro del icono */
    .gt-stack td:has(.celda-objeto) {
      align-items: center;
    }
    .gt-stack td .celda-objeto img {
      width: 30px;
      height: 30px;
    }
  }
</style>
