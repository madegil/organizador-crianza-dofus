---
/** Recuadro destacado dentro de la guía: un consejo o un aviso importante */
interface Props {
  tipo?: 'consejo' | 'aviso';
  titulo?: string;
}
const { tipo = 'consejo', titulo } = Astro.props;
const estilos = {
  consejo: 'bg-blue-50 border-blue-300 text-blue-950',
  aviso: 'bg-amber-50 border-amber-300 text-amber-950',
}[tipo];
const tituloPorDefecto = tipo === 'consejo' ? 'Consejo' : 'Importante';
---

<aside class={`nota flex gap-3 p-3.5 rounded-xl border-2 ${estilos} text-[13px] leading-relaxed`}>
  <span aria-hidden="true" class="shrink-0 mt-0.5">
    {
      tipo === 'consejo' ? (
        <svg viewBox="0 0 24 24" class="w-6 h-6"><path d="M12 2.5a7 7 0 0 0-4 12.7V18h8v-2.8a7 7 0 0 0-4-12.7Z" fill="#f2c14e" /><path d="M9 20.5h6" stroke="#735d40" stroke-width="2.2" stroke-linecap="round" /><path d="M10 9.5a2.5 2.5 0 0 1 2-2" stroke="#fff6d8" stroke-width="1.6" stroke-linecap="round" fill="none" /></svg>
      ) : (
        <svg viewBox="0 0 24 24" class="w-6 h-6"><path d="M12 3 2.5 20h19Z" fill="#f59e0b" stroke-linejoin="round" /><path d="M12 9.5v4.5" stroke="#3a2c1b" stroke-width="2.4" stroke-linecap="round" /><circle cx="12" cy="17" r="1.3" fill="#3a2c1b" /></svg>
      )
    }
  </span>
  <div>
    <p class="font-display text-[15px] leading-tight mb-0.5">{titulo ?? tituloPorDefecto}</p>
    <slot />
  </div>
</aside>
