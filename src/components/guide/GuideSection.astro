---
interface Props {
  id: string;
  title: string;
  /** Texto pequeño sobre el título, p. ej. "Paso 3" */
  eyebrow?: string;
}
const { id, title, eyebrow } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-titulo`}
  class="guide-section scroll-mt-24 bg-white text-slate-700 rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-sm p-4 sm:p-6 space-y-3.5 text-sm leading-relaxed"
>
  <header>
    {eyebrow && <p class="text-[11px] font-bold uppercase tracking-wider text-blue-700">{eyebrow}</p>}
    <h2 id={`${id}-titulo`} class="text-lg sm:text-xl font-extrabold text-slate-900 leading-tight">{title}</h2>
  </header>
  <slot />
</section>
