---
import '../styles/global.css';
import { Navbar } from '../components/Navbar';

interface Props {
  title: string;
  description?: string;
}

const SITE_NAME = 'Gestor de monturas';
const DEFAULT_DESCRIPTION =
  'Organiza la crianza de tus monturas de Dofus 3.5: establo, calculadora de XP y carburantes, colección y árbol de cruces. Tus datos se guardan en tu navegador.';

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const currentPath = Astro.url.pathname;

// Evita "Gestor de monturas | Gestor de monturas" en la página principal
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`;
// Sin barra final (salvo la raíz) para coincidir con los enlaces del menú: /calculadora, /coleccion…
const canonicalPath = currentPath.length > 1 ? currentPath.replace(/\/+$/, '') : currentPath;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url).href;
const ogImageUrl = new URL('/og-image.jpg', Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0b0d11" />

    <!-- Previsualización al compartir (WhatsApp, Discord, Facebook, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo de Gestor de monturas: organiza la crianza de tus monturas de Dofus" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="bg-[#0b0d11] text-slate-100 min-h-screen flex flex-col font-sans selection:bg-blue-500 selection:text-white antialiased">
    <Navbar client:load currentPath={currentPath} />
    
    <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-2 pb-24 md:pb-12">
      <slot />
    </main>

    <footer class="bg-dofus-card/80 border-t border-dofus-border mt-auto py-6 text-center text-xs text-slate-500 hidden md:block">
      <p>
        Gestor de monturas • Basado en las reglas de crianza de Dofus 3.5 • Creado con Astro y Local-First
      </p>
    </footer>
  </body>
</html>
