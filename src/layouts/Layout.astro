---
import '@fontsource/lilita-one/400.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { Navbar } from '../components/Navbar';
import AlmanaxNotice from '../components/AlmanaxNotice.astro';

interface Props {
  title: string;
  description?: string;
}

const SITE_NAME = 'Gestor de monturas';
const DEFAULT_DESCRIPTION =
  'Organiza la crianza de tus monturas de Dofus: establo, calculadora de XP y carburantes, colección y árbol de cruces. Tus datos se guardan en tu navegador.';

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const currentPath = Astro.url.pathname;

// Evita "Gestor de monturas | Gestor de monturas" en la página principal
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`;
// Sin barra final (salvo la raíz) para coincidir con los enlaces del menú: /calculadora, /coleccion…
const canonicalPath = currentPath.length > 1 ? currentPath.replace(/\/+$/, '') : currentPath;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url).href;
const ogImageUrl = new URL('/og-image.jpg', Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#131209" />

    <!-- Previsualización al compartir (WhatsApp, Discord, Facebook, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo de Gestor de monturas: organiza la crianza de tus monturas de Dofus" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-xl focus:bg-kama focus:text-slate-900 focus:font-bold focus:text-sm"
    >
      Saltar al contenido
    </a>
    <Navbar client:load currentPath={currentPath} />
    <AlmanaxNotice />
    
    <main id="contenido" tabindex="-1" class="flex-1 focus:outline-none max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-2 pb-8 md:pb-12">
      <slot />
    </main>

    <footer class="mt-auto pt-6 pb-24 md:pb-8 px-4 text-center text-xs text-[#cdb98f] space-y-2">
      <div class="max-w-3xl mx-auto flex items-center gap-3 mb-4" aria-hidden="true">
        <span class="clavo"></span>
        <span class="flex-1 h-px bg-[#4a321d]"></span>
        <svg viewBox="0 0 24 24" class="w-5 h-5 text-[#88b43a]" fill="currentColor"><path d="M12 2c-1.6 3.1-5.5 4.2-5.5 8.6 0 3.2 2.4 5.6 5.5 5.6s5.5-2.4 5.5-5.6C17.5 6.2 13.6 5.1 12 2Zm0 15.6V22" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span class="flex-1 h-px bg-[#4a321d]"></span>
        <span class="clavo"></span>
      </div>
      <p class="text-[#f3e7c9] font-medium max-w-3xl mx-auto">
        Tus datos se guardan solo en este navegador. Exporta una copia de seguridad desde el Establo de vez en cuando:
        si borras los datos del navegador o cambias de dispositivo, se pierden.
      </p>
      <p>Gestor de monturas, proyecto de fans sin relación con Ankama</p>
    </footer>
  </body>
</html>
