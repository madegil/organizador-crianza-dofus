---
import Layout from '../layouts/Layout.astro';
import GuideSection from '../components/guide/GuideSection.astro';
import GuideTable from '../components/guide/GuideTable.astro';
import ToolLink from '../components/guide/ToolLink.astro';
import Objeto from '../components/guide/Objeto.astro';
import Nota from '../components/guide/Nota.astro';
import MedidorVertical from '../components/guide/MedidorVertical.astro';
import { IconEstablo } from '../components/DofusIcons';
import { SerenityChart } from '../components/guide/SerenityChart';
import { TargetGenCalculator } from '../components/guide/TargetGenCalculator';
import { ALMANAX_BONUSES, MONTH_NAMES } from '../data/almanax';

// Índice: grupos y secciones en el orden de la página
const toc = [
  {
    group: 'Las monturas',
    items: [
      { id: 'cronologia', label: 'Cronología' },
      { id: 'caracteristicas', label: 'Características' },
      { id: 'donde-capturar', label: 'Dónde encontrarlas' },
      { id: 'redes', label: 'Captura y redes' },
    ],
  },
  {
    group: 'Herramientas del ganadero',
    items: [
      { id: 'carburantes', label: 'Carburantes' },
      { id: 'makinas', label: 'Mákinas y capacidades' },
      { id: 'cercados', label: 'Cercados' },
      { id: 'interfaz', label: 'La interfaz de crianza' },
    ],
  },
  {
    group: 'Cómo se cría',
    items: [
      { id: 'como-se-cria', label: 'Resumen' },
      { id: 'serenidad', label: '1. Ajusta la serenidad' },
      { id: 'medidores', label: '2. Llena los medidores' },
      { id: 'cruce', label: '3. Cruza' },
      { id: 'colores', label: '4. De dónde salen los colores' },
      { id: 'esteriles', label: '5. Las estériles' },
      { id: 'experiencia', label: '6. Sube de nivel' },
      { id: 'recompensas', label: 'Recompensas' },
      { id: 'consejos', label: 'Consejos para empezar' },
    ],
  },
];

// Ruta rápida: lo que más se consulta
const quickPath = [
  { id: 'donde-capturar', step: '1', title: 'Captura', text: 'Zonas y redes de captura' },
  { id: 'serenidad', step: '2', title: 'Serenidad', text: 'Qué medidor sube en cada zona' },
  { id: 'medidores', step: '3', title: 'Medidores', text: 'Carburantes, gasto y tiempos' },
  { id: 'cruce', step: '4', title: 'Cruce', text: 'Mákinas y generación objetivo' },
  { id: 'experiencia', step: '5', title: 'Nivel 200', text: 'Experiencia y carburante' },
];

// Almanax: misma fuente que el calendario .ics y el aviso de la página
const almanax = ALMANAX_BONUSES.map((b) => [
  b.year ? `Fecha variable (${b.day} de ${MONTH_NAMES[b.month - 1]} en ${b.year})` : `${b.day} de ${MONTH_NAMES[b.month - 1]}`,
  b.bonus,
]);
// Fecha de cada fila (MM-DD, o AAAA-MM-DD si solo vale un año) para marcar el próximo bonus
const almanaxMonths = ALMANAX_BONUSES.map((b) =>
  `${b.year ? `${b.year}-` : ''}${String(b.month).padStart(2, '0')}-${String(b.day).padStart(2, '0')}`
);
const icsPath = '/almanax-crianza.ics';
const googleCalendarUrl = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent('webcal://organizador-crianza-dofus.vercel.app' + icsPath)}`;

const p = 'text-sm leading-relaxed';

// Plano del Pueblo de los Ganaderos, fila a fila de norte a sur y de oeste a este
const CERCADO = 'bg-[#eef5dc] border-[#88b43a]';
const SERVICIO = 'bg-white border-slate-300';
const pueblo = [
  [
    { tipo: 'cercado', nombre: 'Aprendiz', nivel: 80, pos: '[-20,0]', estilo: CERCADO },
    { tipo: 'cercado', nombre: 'Novato', nivel: 40, pos: '[-19,0]', estilo: CERCADO },
    { tipo: 'cercado', nombre: 'Principiante', nivel: 1, pos: '[-18,0]', estilo: CERCADO },
  ],
  [
    { tipo: 'servicio', nombre: 'Taller', img: '/guia/objetos/red-universal.webp', pos: '[-20,1]', estilo: SERVICIO },
    { tipo: 'servicio', nombre: 'Mercadillo', img: '/guia/objetos/polvo-ganaderia.webp', pos: '[-19,1]', estilo: SERVICIO },
    { tipo: 'servicio', nombre: 'Adela y Eugen', img: '/guia/objetos/geneticha.webp', pos: '[-18,1]', estilo: SERVICIO },
  ],
  [
    { tipo: 'cercado', nombre: 'Iniciado', nivel: 120, pos: '[-20,2]', estilo: CERCADO },
    { tipo: 'cercado', nombre: 'Veterano', nivel: 160, pos: '[-19,2]', estilo: CERCADO },
    { tipo: 'cercado', nombre: 'Maestro', nivel: 200, pos: '[-18,2]', estilo: CERCADO },
  ],
] as const;

// Panel de la cabecera: datos de la tabla de características
const heroMounts = [
  { name: 'Dragopavo', bonus: 'Vitalidad, hasta 400', colors: 66, img: 'https://api.dofusdu.de/dofus2/img/mount/20.png', tone: 'bg-orange-50 border-orange-200', href: '#caracteristicas' },
  { name: 'Mulagua', bonus: '1 PM desde el nivel 100', colors: 120, img: 'https://api.dofusdu.de/dofus3/v1/img/item/97091-128.png', tone: 'bg-sky-50 border-sky-200', href: '#caracteristicas' },
  { name: 'Vueloceronte', bonus: '1 PA desde el nivel 100', colors: 120, img: 'https://api.dofusdu.de/dofus3/v1/img/item/97177-128.png', tone: 'bg-purple-50 border-purple-200', href: '#caracteristicas' },
];
---

<Layout
  title="Guía de crianza de monturas"
  description="Guía completa de crianza en Dofus: dónde capturar dragopavos, mulaguas y vuelocerontes, redes, carburantes, mákinas, cercados, serenidad, cruces y cómo subir tus monturas a nivel 200."
>
  <div class="max-w-7xl mx-auto space-y-4 sm:space-y-5">
    <!-- Cabecera y ruta rápida -->
    <header class="relative overflow-hidden bg-white text-slate-700 rounded-2xl sm:rounded-3xl border border-slate-200 p-4 sm:p-6 space-y-5">
      <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_19rem] lg:grid-cols-[minmax(0,1fr)_22rem] md:items-center">
        <div class="space-y-3">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl text-slate-900 leading-tight">Guía de crianza de monturas</h1>
          <p class="text-base leading-relaxed text-slate-700 max-w-[54ch]">
            Todo lo que necesitas para criar dragopavos, mulaguas y vuelocerontes desde la actualización 3.5.
          </p>
          <p class="text-sm leading-relaxed text-slate-600 max-w-[54ch]">
            Dónde capturarlos, cómo funcionan los cercados y los carburantes, y cómo llegar a la generación 10.
          </p>
        </div>

        <aside aria-labelledby="tres-monturas" class="rounded-2xl bg-slate-50 border border-slate-200 p-3">
          <p id="tres-monturas" class="font-display text-[15px] text-slate-900 px-1 mb-1.5">Las tres monturas</p>
          <ul class="space-y-1">
            {
              heroMounts.map((m) => (
                <li>
                  <a
                    href={m.href}
                    class="group flex items-center gap-3 p-1.5 rounded-xl"
                  >
                    <span class={`grid place-items-center w-11 h-11 rounded-xl shrink-0 border ${m.tone}`}>
                      <img src={m.img} alt="" width="40" height="40" loading="lazy" class="w-10 h-10 object-contain duration-500 ease-rebote group-hover:-translate-y-0.5 group-hover:scale-110" />
                    </span>
                    <span class="flex-1 min-w-0 leading-tight">
                      <span class="block text-sm font-extrabold text-slate-900">{m.name}</span>
                      <span class="block text-xs text-slate-600">{m.bonus}</span>
                    </span>
                    <span class="text-right leading-tight shrink-0">
                      <span class="block text-sm font-extrabold text-slate-900">{m.colors}</span>
                      <span class="block text-[11px] text-slate-500">colores</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
      <nav aria-label="Ruta rápida" class="pt-4 border-t border-slate-200">
        <p class="text-sm font-bold text-slate-900 mb-3">Tu ruta de ganadero</p>
        <ol class="ruta grid grid-cols-5 gap-x-1 sm:gap-x-2 relative">
          {
            quickPath.map((q) => (
              <li class="relative">
                <a
                  href={`#${q.id}`}
                  class="ruta-paso group h-full flex flex-col items-center text-center gap-1 px-0.5 sm:px-2 pb-2 rounded-xl"
                >
                  <span
                    class="sello relative z-10 grid place-items-center w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-blue-600 text-white font-display text-lg sm:text-xl border-2 border-blue-900 shadow-[inset_0_2px_0_rgba(214,240,160,0.45),0_3px_0_#1a2a09] duration-500 ease-rebote group-hover:-translate-y-1 group-hover:rotate-[-8deg]"
                    aria-hidden="true">{q.step}</span
                  >
                  <span class="sr-only">Paso {q.step}:</span>
                  <span class="text-[11px] min-[380px]:text-xs sm:text-sm font-extrabold text-slate-900 group-hover:text-blue-700 leading-tight">{q.title}</span>
                  <span class="hidden sm:block text-xs text-slate-600 leading-snug text-balance">{q.text}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </header>

    <div class="lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-5 items-start">
      <!-- Índice: desplegable en móvil, fijo al lado en escritorio -->
      <aside class="mb-4 lg:mb-0 lg:sticky lg:top-4">
        <details class="toc lg:hidden bg-white text-slate-700 rounded-2xl border border-slate-200/90 shadow-sm">
          <summary class="cursor-pointer select-none p-3.5 text-sm font-extrabold text-slate-900">Índice de la guía</summary>
          <nav aria-label="Índice de la guía (móvil)" class="px-3.5 pb-3.5">
            {
              toc.map((g) => (
                <div class="mt-2">
                  <p class="font-display text-[15px] text-slate-900">{g.group}</p>
                  <ul class="mt-1 space-y-0.5">
                    {g.items.map((i) => (
                      <li><a href={`#${i.id}`} class="block py-1 text-sm text-slate-700 hover:text-blue-700">{i.label}</a></li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </nav>
        </details>
        <nav
          aria-label="Índice de la guía"
          class="hidden lg:block bg-white text-slate-700 rounded-2xl border border-slate-200/90 shadow-sm p-3.5 max-h-[calc(100vh-2rem)] overflow-y-auto"
        >
          {
            toc.map((g, gi) => (
              <div class={gi > 0 ? 'mt-3' : ''}>
                <p class="font-display text-[15px] text-slate-900">{g.group}</p>
                <ul class="mt-1 space-y-0.5">
                  {g.items.map((i) => (
                    <li>
                      <a
                        href={`#${i.id}`}
                        data-toc-link={i.id}
                        class="toc-link block px-2 py-1 rounded-lg text-[13px] text-slate-600 hover:text-blue-700"
                      >
                        {i.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      <div class="space-y-4 sm:space-y-5 min-w-0">
        <!-- Las monturas -->
        <GuideSection id="cronologia" title="Cronología de las monturas">
          <p class={p}>
            La crianza llegó a Dofus en septiembre de 2006 con los dragopavos, y casi veinte años después funciona con un
            sistema rehecho en la actualización 3.5. Las mulaguas y los vuelocerontes se sumaron mucho más tarde, cada uno
            con su propia actualización.
          </p>
          <ol class="relative border-l-2 border-slate-200 ml-2 space-y-4">
            {
              [
                ['Actualización 3.7', 'Ajustes al sistema', 'La capacidad de cada medidor del cercado se duplicó, la Optimákina pasó a dar +20 % de probabilidad de generación objetivo, los carburantes cambiaron de nombre (no de precio ni efecto) y la interfaz marca las monturas que aún te faltan en los logros.'],
                ['Actualización 3.5', 'Reforma completa de la crianza', 'Nace el oficio de ganadero, desaparecen los certificados y los cercados privados, las monturas ganan experiencia solo en el cercado, el nivel máximo sube a 200 y cada cruce da un único bebé. Todas las monturas anteriores quedan seniles. Las mulaguas ganan dos generaciones nuevas.'],
                ['Junio de 2018', 'Llegan los vuelocerontes', 'Se introducen con la actualización de los Nimbos. Dan 1 PA desde el nivel 100.'],
                ['Junio de 2016', 'Llegan las mulaguas', 'Se introducen con la actualización de los Abismos de Sufokia. Dan 1 PM desde el nivel 100.'],
                ['Septiembre de 2006', 'Llegan los dragopavos', 'Aparecen con la Montaña de los Koalaks. Son la primera y única montura del juego durante diez años.'],
              ].map(([date, title, text]) => (
                <li class="pl-4 relative">
                  <span class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full bg-blue-600 ring-4 ring-white" aria-hidden="true" />
                  <p class="text-xs font-bold text-blue-700">{date}</p>
                  <p class="font-extrabold text-slate-900">{title}</p>
                  <p class="text-[13px] leading-relaxed">{text}</p>
                </li>
              ))
            }
          </ol>
          <Nota tipo="aviso" titulo="Si jugabas antes de la 3.5">
            Tus monturas antiguas siguen sirviendo para equiparlas y subirlas de nivel, pero <strong>ya no se pueden cruzar ni
            clonar</strong>. Para avanzar en los logros de generaciones hay que <mark class="resaltado">empezar de cero con monturas
            capturadas después del cambio</mark>.
          </Nota>
        </GuideSection>

        <GuideSection id="caracteristicas" title="Características">
          <p class={p}>
            Hay tres tipos de montura y todos se crían igual; lo que cambia entre ellos es el bonus fijo que dan y cuántos colores
            se pueden obtener. Una montura se equipa en el mismo lugar de la mascota o mascotura, exige nivel 60 de personaje y te
            deja moverte más rápido que a pie.
          </p>
          <GuideTable
            caption="Comparación de los tres tipos de montura"
            head={['Tipo', 'Bonus común', 'Colores capturables (gen. 1)', 'Colores criables', 'Recurso al extraer']}
            rows={[
              ['Dragopavo', '**Vitalidad:** **300** a nivel 100, **400** a nivel 200', '**3:** Almendrado, Dorado, Pelirrojo', '**66** (+2 especiales que no se reproducen)', { item: 'neurona-dragopavo' }],
              ['Mulagua', '**1 PM** desde el nivel 100', '**5:** Ébano, Índigo, Púrpura, Orquídea, Dorada', '**120**', { item: 'ambar-mulagua' }],
              ['Vueloceronte', '**1 PA** desde el nivel 100', '**4:** Ébano, Índigo, Púrpura, Orquídeo', '**120**', { item: 'cuerno-vueloceronte' }],
            ]}
          />
          <p class={p}>
            Además del bonus común, <strong>cada color aporta su propia característica</strong>. Una montura de un solo color da el
            bonus común más la característica de ese color. Una bicolor da el bonus común más las dos características de sus
            colores, pero <mark class="resaltado">cada una con un valor más bajo que en la monocolor</mark>.
          </p>
          <p class={p}>
            Las monturas van del nivel 1 al 200. Sus estadísticas suben rápido hasta el 100 y a partir de ahí crecen despacio. Un
            ejemplo: una Mulagua Dorada da 1 PM y 50 de potencia a nivel 100, y 1 PM y 70 de potencia a nivel 200.
          </p>
          <p class={p}>
            Los dos dragopavos especiales (en armadura y de plumas) se compran a Gladiagob en la Feria del Trool, en [-11,-37], por
            50 gladiatones cada uno. Solo pueden subir de nivel.
          </p>
          <ToolLink href="/coleccion" label="Colección">Mira los bonus de cada color y marca las que ya tienes.</ToolLink>
        </GuideSection>

        <GuideSection id="donde-capturar" title="Dónde encontrar cada montura salvaje">
          <p class={p}>
            Cada tipo vive en su propia zona y solo se puede capturar la generación 1; el resto de colores sale de los cruces. Las
            salvajes son monstruos de nivel 62 a 70, fáciles para un personaje con buen nivel.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            {
              [
                { name: 'Dragopavo', img: 'https://api.dofusdu.de/dofus2/img/mount/20.png', tone: 'border-orange-200 bg-orange-50/60', zone: 'Territorio de los dragopavos salvajes, Montaña de los Koalaks', how: 'El zaap más cercano es el del Pueblo de los Ganaderos, en [-16,1]', fight: 'Hasta 900 PV. Todas pueden quitarte los hechizos de mejora (desembrujar).' },
                { name: 'Mulagua', img: 'https://api.dofusdu.de/dofus3/v1/img/item/97091-128.png', tone: 'border-sky-200 bg-sky-50/60', zone: 'Cuenca de las mulaguas, Bahía de Sufokia', how: 'Tres entradas: la escafandra del taller de ganaderos de Sufokia en [19,23]; la escalera frente al submarino steamer en [22,19]; o la barca del Territorio de los Bandidos en [15,19] y luego la cuerda', fight: 'Hasta 1000 PV. Te quitan un 10 % de daño final durante 1 turno. El elemento de su golpe depende del color: Dorada neutro, Ébano aire, Índigo agua, Púrpura tierra, Orquídea fuego.' },
                { name: 'Vueloceronte', img: 'https://api.dofusdu.de/dofus3/v1/img/item/97177-128.png', tone: 'border-purple-200 bg-purple-50/60', zone: 'Acaballero de Brakmar, al sur de la ciudad', how: 'Salida sur de Brakmar, en [-25,40]', fight: 'Hasta 1000 PV. Atraen, empujan, quitan PA o PM; la Púrpura reduce un 30 % el daño final en zona durante 1 turno.' },
              ].map((m) => (
                <article class={`p-3.5 rounded-xl border ${m.tone} space-y-2 text-[13px] leading-relaxed`}>
                  <h3 class="flex items-center gap-2 text-base font-extrabold text-slate-900">
                    <img src={m.img} alt="" width="48" height="48" loading="lazy" class="w-12 h-12 object-contain drop-shadow-[0_2px_0_rgba(0,0,0,0.2)]" />
                    {m.name}
                  </h3>
                  <p><span class="font-bold text-slate-900">Zona:</span> {m.zone}</p>
                  <p><span class="font-bold text-slate-900">Cómo llegar:</span> {m.how}</p>
                  <p><span class="font-bold text-slate-900">En combate:</span> {m.fight}</p>
                </article>
              ))
            }
          </div>
          <Nota tipo="aviso" titulo="Si vas con poco nivel">
            Los <strong>vuelocerontes</strong> son los más molestos de los tres: el Ébano aplica Pesanteur a todo el campo cada dos
            turnos y la Orquídea <mark class="resaltado">reduce a la mitad las curas que recibes</mark>.
          </Nota>
        </GuideSection>

        <GuideSection id="redes" title="Tipos de captura y efecto de cada red">
          <p class={p}>
            Para capturar necesitas <strong>una red equipada en los consumibles de combate</strong>; la red te da el hechizo
            <strong>Domesticación de montura</strong>, y lo que hace ese hechizo depende de la red. Las redes las fabrica el oficio de ganadero y solo puedes equipar
            las de tu nivel de oficio o inferior.
          </p>
          <GuideTable
            caption="Redes de captura"
            head={['Red', 'Nivel de ganadero', 'Para qué tipo', 'Efecto del hechizo']}
            rows={[
              [{ item: 'red-universal', text: 'Red de captura universal' }, 1, 'Cualquier tipo', 'Captura la montura que apuntas.'],
              [{ item: 'red-multiplicadora', text: 'Red multiplicadora' }, 100, 'Una por tipo', 'Captura la montura apuntada y **te da una copia**.'],
              [{ item: 'red-reforzada', text: 'Red reforzada' }, 150, 'Una por tipo', 'Captura **todas las monturas** en un círculo de radio 3.'],
              [{ item: 'red-multiplicadora-reforzada', text: 'Red multiplicadora reforzada' }, 200, 'Una por tipo', 'Captura todo lo que hay en el círculo de radio 3 y **duplica cada una**.'],
            ]}
          />
          <p class={p}>
            En total hay 10 redes. La universal sirve para los tres tipos de montura. Cada una de las otras tres (multiplicadora,
            reforzada y multiplicadora reforzada) tiene una versión para dragopavos, otra para mulaguas y otra para vuelocerontes,
            y <strong>cada versión solo captura monturas de su tipo</strong>: por ejemplo, la Red multiplicadora de mulagua no sirve con un
            vueloceronte. Por eso son 1 + 3 × 3 = 10. Las copias de las monturas que dan las redes multiplicadoras tienen el mismo
            color pero no siempre el mismo sexo, lo que viene bien para formar parejas.
          </p>
          <p class={p}>El hechizo cuesta <strong>1 PA</strong>, llega a <strong>7 de alcance sin línea de visión</strong> y se lanza <mark class="resaltado">una vez por combate</mark>.</p>
          <ol class="space-y-2 text-sm leading-relaxed">
            {
              [
                'Equipa la red que corresponda al tipo de montura en tus consumibles de combate.',
                'Entra en combate contra un grupo de monturas salvajes.',
                'Lanza Domesticación de montura sobre la montura (o sobre el centro del grupo, si usas una red reforzada). Las afectadas muestran el estado Capturada encima de la cabeza.',
                'Termina el combate cuando quieras. El estado no caduca, así que la captura está asegurada.',
              ].map((s, i) => (
                <li class="flex gap-3">
                  <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center" aria-hidden="true">{i + 1}</span>
                  <span>{s}</span>
                </li>
              ))
            }
          </ol>
          <p class={p}>
            Si hay varios jugadores en el combate, cada montura solo puede capturarla uno. Una vez marcada por alguien, nadie se la
            quita, pero los demás pueden marcar las que queden libres.
          </p>
          <p class={p}>
            Las monturas capturadas salen de <strong>nivel 1 y generación 1</strong>, y ya se pueden equipar. Cada captura da
            <strong>60 de experiencia de ganadero</strong> por montura.
          </p>
          <ToolLink href="/establo" label="Establo">Registra tus capturas para seguir su serenidad y sus medidores.</ToolLink>
        </GuideSection>

        <!-- Herramientas del ganadero -->
        <GuideSection id="carburantes" title="Carburantes">
          <p class={p}>
            Los carburantes llenan los medidores del cercado y son <mark class="resaltado">lo que realmente cría a tus monturas</mark>. Hay seis medidores
            (pérdida de serenidad, aumento de serenidad, aguante, madurez, amor y experiencia de montura) y cada uno tiene sus
            carburantes, que se diferencian por tipo y por tamaño. Los que llenan el medidor de aguante se llaman carburantes de
            resistencia.
          </p>
          <p class={p}>
            <strong>El tipo decide hasta dónde puede llenar el medidor.</strong> Un carburante nunca pasa el tope de su tramo, pero uno
            superior sí sirve para llenar los tramos de abajo.
          </p>
          <GuideTable
            caption="Tipos de carburante"
            head={['Tipo', 'Llena el medidor hasta', 'Nivel de ganadero para fabricarlo', 'Precio del gigantesco en polvo de crianza']}
            rows={[
              [{ item: 'extracto', text: 'Extracto' }, '**80.000**', 5, 50],
              [{ item: 'filtro', text: 'Filtro' }, '**140.000**', 55, 200],
              [{ item: 'pocima', text: 'Poción' }, '**180.000**', 105, 800],
              [{ item: 'elixir', text: 'Elixir' }, '**200.000**', 155, '3.200'],
            ]}
          />
          <p class={p}>
            <strong>El tamaño decide cuánto carga cada unidad:</strong> minúsculo 2.000, pequeño 4.000, normal 6.000, grande 8.000 y
            gigantesco <strong>10.000</strong>. Cada diez niveles de ganadero se desbloquea un tamaño nuevo.
          </p>
          <p class={p}>
            <strong>No hace falta tener el oficio para usarlos</strong>; puedes comprarlos en el mercadillo. El
            <Objeto id="polvo-ganaderia">polvo de crianza</Objeto> se cambia por carburantes gigantescos con <strong>Adela Gana</strong>
            en [-18,1]. Quien tenía objetos de crianza, pociones de experiencia o redes antes
            de la 3.5 recibió 0,55 de polvo por cada punto de durabilidad que les quedaba.
          </p>
          <p class={p}>
            Cómo se consumen y cuánto duran está en la sección <a href="#medidores" class="font-semibold text-blue-700 underline">Llena los medidores</a>.
          </p>
          <ToolLink href="/calculadora" label="Calculadora">Calcula cuánto carburante necesitas para llevar una montura al nivel que quieras.</ToolLink>
        </GuideSection>

        <GuideSection id="makinas" title="Mákinas y capacidades especiales">
          <p class={p}>
            Una mákina es un consumible opcional que pones entre los dos padres al cruzarlos, y cambia algo del bebé que va a nacer.
            <strong>Solo cabe una por cruce.</strong>
          </p>
          <GuideTable
            caption="Tipos de mákina"
            head={['Mákina', 'Efecto en el bebé']}
            rows={[
              [{ item: 'animakina' }, 'Eliges si nace **macho o hembra**.'],
              [{ item: 'kromakina' }, 'Nace con la capacidad **Camaleón** (100 % de éxito).'],
              [{ item: 'optimakina' }, '**+20 %** de probabilidad de que nazca de la generación objetivo.'],
            ]}
          />
          <p class={p}>
            Hay una mákina de cada clase para cada tipo de montura y cada generación. Debe ser de la generación objetivo del cruce o
            superior.
          </p>
          <Nota titulo="Ejemplo">
            Si la generación objetivo es la 5, <strong>sirve una mákina de generación 8</strong>, pero <strong>no una de generación 4</strong>.
          </Nota>
          <p class={p}>Las capacidades <strong>salen al azar al nacer y no se heredan</strong>. La única que se elige es Camaleón, con la <Objeto id="kromakina" />.</p>
          <GuideTable
            caption="Capacidades especiales"
            head={['Capacidad', 'Efecto', 'Probabilidad al nacer']}
            rows={[
              ['Enamoradiza', 'Gana amor al doble de velocidad', '8 %'],
              ['Resistente', 'Gana aguante al doble de velocidad', '8 %'],
              ['Sabia', 'Gana experiencia al doble de velocidad', '6 %'],
              ['Reproductora', 'Da un bebé extra al cruzarla', '3 %'],
              ['Camaleón', 'Toma los colores de tu personaje al equiparla', 'Solo con Kromákina'],
            ]}
          />
          <p class={p}>
            La Reproductora funciona aunque la tenga el macho. <mark class="resaltado">Cruzar dos Reproductoras no sirve de nada</mark>:
            siguen dando un solo bebé extra.
          </p>
        </GuideSection>

        <GuideSection id="cercados" title="Cercados: dónde están y cómo se accede">
          <p class={p}>
            <mark class="resaltado">Todos los cercados del juego están en el Pueblo de los Ganaderos</mark>, a la izquierda del zaap
            [-16,1]; no hay ninguno más en el Mundo de los Doce. Se desbloquean con el nivel del oficio de ganadero, hasta un máximo
            de <strong>6</strong>, y cada uno tiene <strong>10 plazas</strong>.
          </p>
          <div>
            <GuideTable
              caption="Cercados del Pueblo de los Ganaderos"
              head={['Cercado', 'Posición', 'Nivel de ganadero']}
              rows={[
                ['Del principiante', '[-18,0]', 1],
                ['Del novato', '[-19,0]', 40],
                ['Del aprendiz', '[-20,0]', 80],
                ['Del iniciado', '[-20,2]', 120],
                ['Del veterano', '[-19,2]', 160],
                ['Del maestro', '[-18,2]', 200],
              ]}
            />

          </div>
          <!-- Plano del pueblo: 3 columnas (x −20, −19, −18) × 3 filas (y 0, 1, 2), con el zaap al este -->
          <figure class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_17rem] gap-4 items-start">
            <div class="space-y-2">
              <div
                class="plano grid grid-cols-[repeat(3,minmax(0,1fr))_auto] gap-1.5 sm:gap-2 p-2 sm:p-3 rounded-2xl bg-[#a5c95e] border-2 border-[#4a7a12]"
                role="img"
                aria-label="Plano del Pueblo de los Ganaderos: tres cercados arriba, tres abajo, en medio el taller, el mercadillo y los NPC, y el zaap al este en [-16,1]"
              >
                {
                  pueblo.map((fila, fi) => (
                    <>
                      {fila.map((c) => (
                        <div class={`plano-celda flex flex-col items-center justify-center gap-0.5 text-center p-1.5 sm:p-2 rounded-xl border-2 min-h-[6.5rem] ${c.estilo}`}>
                          <span class="w-9 h-9 sm:w-10 sm:h-10 grid place-items-center" aria-hidden="true">
                            {c.tipo === 'cercado' ? <IconEstablo className="w-9 h-9 sm:w-10 sm:h-10" /> : <img src={c.img} alt="" width="40" height="40" class="w-9 h-9 sm:w-10 sm:h-10 object-contain" />}
                          </span>
                          <span class="text-[11px] sm:text-xs font-extrabold leading-tight text-slate-900">{c.nombre}</span>
                          {c.nivel && <span class="text-[10px] sm:text-[11px] font-semibold text-slate-600">Nivel {c.nivel}</span>}
                          <span class="text-[11px] sm:text-xs">{c.pos}</span>
                        </div>
                      ))}
                      {fi === 1 ? (
                        <div class="flex flex-col items-center justify-center gap-0.5 px-1 text-center" aria-hidden="true">
                          <svg viewBox="0 0 24 24" class="w-6 h-6 text-[#2a450d]"><path d="M4 12h14m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                          <span class="text-[10px] font-extrabold text-[#18290a] leading-tight">Zaap</span>
                        </div>
                      ) : (
                        <span aria-hidden="true" />
                      )}
                    </>
                  ))
                }
              </div>
              <p class="text-xs text-slate-600">
                Cercados en verde, servicios en pergamino. El zaap queda al este, en [-16,1].
              </p>
            </div>
            <div class="space-y-1.5">
              <img
                src="/guia/pueblo-ganaderos.png"
                alt="Captura del juego: el Pueblo de los Ganaderos visto en el minimapa, con los seis cercados de madera, el taller, el mercadillo y los NPC"
                width="374"
                height="304"
                loading="lazy"
                class="w-full max-w-[17rem] rounded-xl border-2 border-slate-300 shadow-[0_3px_0_#c4ac80]"
              />
              <figcaption class="text-xs text-slate-600">Así se ve en el juego.</figcaption>
            </div>
          </figure>
          <p class={p}>
            <strong>Los seis funcionan igual</strong>; el del maestro no cría más rápido que el del principiante. Las plazas son de la cuenta, así que
            otro personaje de la misma cuenta no te da cercados extra.
          </p>
          <p class={p}>
            Cada mapa de cercado tiene además un zaapi: si haces <strong>doble clic en un cercado del minimapa</strong>, el personaje
            va solo por el camino más corto.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <Objeto id="pocima-teletransporte" size="ficha">Pócima de teletransportación</Objeto>
            <div class="text-[13px] leading-relaxed space-y-2">
              <p>
                <strong>Para llegar rápido</strong>, esta pócima te deja directamente en [-18,1]. La fabrican los
                <strong>alquimistas de nivel 60</strong> con:
              </p>
              <ul class="flex flex-wrap gap-2">
                <li class="flex items-center gap-1.5 px-2 py-1 rounded-lg bg-white border border-slate-200"><strong>2 ×</strong> <Objeto id="pez-gatito" /></li>
                <li class="flex items-center gap-1.5 px-2 py-1 rounded-lg bg-white border border-slate-200"><strong>2 ×</strong> <Objeto id="avena" /></li>
                <li class="flex items-center gap-1.5 px-2 py-1 rounded-lg bg-white border border-slate-200"><strong>2 ×</strong> <Objeto id="menta-salvaje" /></li>
              </ul>
            </div>
          </div>
          <p class={p}>Entre los cercados hay tres mapas de servicio:</p>
          <ul class="list-disc pl-5 space-y-1 text-sm leading-relaxed">
            <li>[-20,1]: el <strong>taller de ganaderos</strong>, donde se fabrican redes, carburantes y mákinas.</li>
            <li>[-19,1]: el <strong>mercadillo de criaturas</strong>.</li>
            <li>[-18,1]: <strong>Adela Gana</strong>, que vende carburantes por polvo de crianza, y <strong>Eugen Eticha</strong>, que cambia las genetichas.</li>
          </ul>
        </GuideSection>

        <GuideSection id="interfaz" title="La interfaz de crianza">
          <p class={p}>
            La interfaz se abre desde el botón Crianza del menú (<kbd class="tecla">D</kbd> por defecto) y funciona en cualquier parte
            del mapa, <strong>salvo para meter o sacar monturas de un cercado</strong>. Para eso tienes que estar en uno de los seis mapas de cercado; si no lo estás,
            los cercados aparecen con un candado.
          </p>
          <p class={p}>
            Desde cualquier lugar puedes recargar carburante, activar o cambiar medidores, pasar monturas entre el inventario y el
            establo, y cruzar, clonar o extraer.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div class="p-3.5 rounded-xl border border-slate-200 bg-slate-50/60 space-y-2">
              <h3 class="font-extrabold text-slate-900">Parte izquierda: tu crianza</h3>
              <ul class="space-y-1.5 text-[13px] leading-relaxed">
                <li><span class="font-bold text-slate-900">Filtros:</span> ordenan el establo o el cercado para ver solo lo que buscas, por ejemplo por serenidad o por el medidor que les falta.</li>
                <li><span class="font-bold text-slate-900">Establo:</span> guarda hasta <strong>500 monturas</strong>.</li>
                <li><span class="font-bold text-slate-900">Genética:</span> un árbol con todos los cruces posibles. También se abre con clic derecho sobre una montura.</li>
                <li><span class="font-bold text-slate-900">Panel superior:</span> elige qué se muestra a la derecha (cercado, apareamiento, clonación o extracción).</li>
              </ul>
            </div>
            <div class="p-3.5 rounded-xl border border-slate-200 bg-slate-50/60 space-y-2">
              <h3 class="font-extrabold text-slate-900">Parte derecha: el cercado</h3>
              <p class="text-[13px] leading-relaxed">
                En el centro eliges qué cercado ver. Arriba están sus medidores y abajo las monturas que tiene dentro. Puedes
                arrastrar monturas desde el establo, el inventario u otro cercado.
              </p>
            </div>
          </div>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[13px] leading-relaxed" aria-label="Medidores del cercado">
            {
              [
                ['bg-violet-500', 'Violeta', 'Pérdida y aumento de serenidad', 'Baja o sube la serenidad. Solo uno de los dos puede estar activo.'],
                ['bg-yellow-400', 'Amarillo', 'Aguante', 'Sube el aguante si la serenidad es negativa.'],
                ['bg-sky-500', 'Azul', 'Madurez', 'Sube la madurez si la serenidad está entre −2.000 y 2.000.'],
                ['bg-rose-500', 'Rojo', 'Amor', 'Sube el amor si la serenidad es positiva.'],
                ['bg-amber-200', 'Beige', 'Experiencia de montura', 'Da experiencia, sin condición de serenidad.'],
              ].map(([dot, color, name, what]) => (
                <li class="flex gap-2.5 p-2.5 rounded-xl border border-slate-200 sm:last:col-span-2">
                  <span class={`mt-1 w-3 h-3 rounded-full flex-shrink-0 ${dot}`} aria-hidden="true" />
                  <span><span class="font-bold text-slate-900">{name}</span> <span class="text-slate-500">({color})</span>. {what}</span>
                </li>
              ))
            }
          </ul>
          <h3 class="font-extrabold text-slate-900 pt-1">La ficha de una montura</h3>
          <p class={p}>
            Al pasar el ratón por una montura ves, de arriba abajo: nombre, colores, nivel, sexo, tipo y generación; sus barras de
            serenidad, aguante (rayo), madurez (gota) y amor (corazón), que se iluminan al llegar al máximo; su experiencia, su
            capacidad si tiene una y su estado de fertilidad; los bonus que da equipada; y por último su genealogía (padres y
            abuelos), que no aparece en las recién capturadas.
          </p>
          <GuideTable
            caption="Estados de fertilidad"
            head={['Estado', 'Qué significa']}
            rows={[
              ['Fértil', 'Puede cruzarse, pero aún hay que llenar aguante, madurez y amor.'],
              ['Fecunda', 'Los tres medidores están llenos y puede cruzarse ya.'],
              ['Estéril', 'Ya se cruzó. No puede volver a hacerlo, pero sí clonarse.'],
              ['Senil', 'Montura anterior a la 3.5. No se cruza ni se clona.'],
            ]}
          />
          <p class={p}>
            En el establo y el cercado cada montura lleva una carita de color que resume qué puede ganar con su serenidad actual:
            verde, solo amor; violeta, amor y madurez; azul, aguante y madurez; roja, solo aguante.
          </p>
          <p class={p}>Las otras tres vistas del panel derecho (cruce, clonación y extracción) se explican en la sección siguiente.</p>
        </GuideSection>

        <!-- Cómo se cría -->
        <GuideSection id="como-se-cria" title="Cómo se cría">
          <p class={p}>
            Criar consiste en llevar a dos monturas del mismo tipo y sexo opuesto a fecundas, cruzarlas y quedarte con el bebé. Para
            que sean fecundas, sus medidores de aguante, madurez y amor tienen que llegar a 20.000, y cada uno solo sube con la
            serenidad en una zona concreta.
          </p>
          <ol class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-[13px]">
            {
              toc[2].items.slice(1, 7).map((i) => (
                <li><a href={`#${i.id}`} class="block p-2.5 rounded-xl bg-slate-50 border border-slate-200 font-semibold text-slate-800 hover:border-blue-300 hover:bg-blue-50/60">{i.label}</a></li>
              ))
            }
          </ol>
        </GuideSection>

        <GuideSection id="serenidad" eyebrow="Cómo se cría · Paso 1" title="Ajusta la serenidad">
          <p class={p}>
            La serenidad va de −5.000 a 5.000. Con el medidor de pérdida de serenidad la bajas y con el de aumento la subes. La zona en
            la que esté decide qué medidores pueden subir:
          </p>
          <SerenityChart client:visible />
          <GuideTable
            caption="Medidores que suben según la serenidad"
            head={['Serenidad', 'Sube']}
            rows={[
              ['−5.000 a −2.001', 'Solo aguante'],
              ['−2.000 a −1', 'Aguante y madurez'],
              ['0 a 2.000', 'Amor y madurez'],
              ['2.001 a 5.000', 'Solo amor'],
            ]}
          />
          <p class={p}>
            <mark class="resaltado">Lo ideal es mantenerlas entre −2.000 y 2.000</mark>, cerca de 0, donde suben dos medidores a la vez.
          </p>
          <Nota tipo="aviso" titulo="Vigila los medidores de serenidad">
            Si dejas un medidor de serenidad activo y te olvidas, la montura llega a uno de los extremos y
            <strong>tienes que devolverla</strong> a la zona buena.
          </Nota>
        </GuideSection>

        <GuideSection id="medidores" eyebrow="Cómo se cría · Paso 2" title="Llena los medidores en el cercado">
          <p class={p}>
            Puedes tener <strong>hasta dos medidores activos por cercado</strong> (se activan con un clic, desde cualquier sitio) y afectan a todas las
            monturas que haya dentro. Para recargarlos, arrastra el carburante del inventario a la interfaz. Cada medidor llega a
            200.000 y cada 10 segundos gasta según el tramo en que está; cada montura del cercado gana lo mismo que se gasta.
          </p>
          <MedidorVertical />
          <p class={p}>
            Un medidor lleno tarda unas <strong>35 h 39 min</strong> en vaciarse del todo.
          </p>
          <Nota titulo="Llena el cercado">
            El medidor <strong>gasta lo mismo con 1 montura que con 10</strong>, así que conviene llenar las 10 plazas. Y si nadie
            dentro puede aprovecharlo, no se gasta.
          </Nota>
          <ToolLink href="/establo" label="Establo">Anota la serenidad y los medidores de cada montura para agruparlas por cercado.</ToolLink>
        </GuideSection>

        <GuideSection id="cruce" eyebrow="Cómo se cría · Paso 3" title="Cruza dos monturas fecundas">
          <p class={p}>
            Abre la vista de cruce, pon un macho y una hembra fecundos del mismo tipo (tienen que estar en el establo, no en el
            inventario ni en un cercado) y, si quieres, una mákina en el centro. La interfaz muestra la probabilidad de cada bebé
            posible y la experiencia de ganadero que ganarás: 30 por generación de cada padre.
          </p>
          <p class={p}>
            El bebé nace al instante, de nivel 1, con los medidores a 0 y sexo al azar (salvo con <Objeto id="animakina" />).
            <mark class="resaltado">Cada pareja da un solo bebé</mark>, dos si uno tiene Reproductora, y <strong>ambos padres quedan
            estériles</strong>.
          </p>
        </GuideSection>

        <GuideSection id="colores" eyebrow="Cómo se cría · Paso 4" title="Entiende de dónde salen los colores">
          <p class={p}>
            El color del bebé depende de sus padres y de sus abuelos; el árbol no va más allá. Los padres pesan más que los abuelos,
            y un color que se repite varias veces en el árbol tiene más probabilidad. En mulaguas y vuelocerontes las generaciones
            impares pueden tener varios cruces posibles (la Mulagua Esmeralda tiene 8); en dragopavos siempre hay uno solo.
          </p>
          <p class={p}>
            La generación objetivo es la más alta que puede salir del cruce, contando el árbol completo. El bebé tiene un 30 % extra
            de salir de esa generación, que se reparte si hay varias opciones. A eso se suman el nivel de los padres y la Optimákina:
          </p>
          <p class="p-3.5 rounded-xl bg-white border-2 border-slate-300 shadow-[0_3px_0_#c4ac80] text-[14px] leading-relaxed text-slate-900">
            <strong>Probabilidad</strong> = 30 % + 0,15 % × (nivel del padre 1 + nivel del padre 2) + 20 % con
            <Objeto id="optimakina" />
          </p>
          <p class={p}>
            <strong>Dos padres de nivel 200 dan un 90 %</strong>, y dos de nivel 167 con Optimákina llegan al <strong>100 %</strong>. Subir monturas a 200 lleva mucho
            tiempo, así que muchos ganaderos se quedan en un punto medio, entre nivel 50 y 100.
          </p>
          <TargetGenCalculator client:visible />
          <ToolLink href="/cruces" label="Cruces">Consulta qué pareja necesitas para cada color y generación.</ToolLink>
        </GuideSection>

        <GuideSection id="esteriles" eyebrow="Cómo se cría · Paso 5" title="Qué hacer con las estériles">
          <ul class="space-y-2 text-sm leading-relaxed">
            <li class="p-3 rounded-xl border border-slate-200"><span class="font-bold text-slate-900">Clonar:</span> pones <strong>dos monturas estériles</strong> del mismo tipo y generación, se destruyen ambas y recuperas una al azar, fértil, con su sexo, genealogía y serenidad, pero con los medidores a 0 y sin capacidad. <mark class="resaltado">Es la única forma de sacar dos monturas de una pareja.</mark></li>
            <li class="p-3 rounded-xl border border-slate-200 space-y-2">
              <p><span class="font-bold text-slate-900">Extraer:</span> destruye la montura y te da <strong>tantos recursos como su generación</strong> (desde la 2; una senil da 1). Los recursos sirven para fabricar redes y mákinas.</p>
              <div class="flex flex-wrap gap-2 text-[13px]">
                <span class="px-2 py-1 rounded-lg bg-slate-50 border border-slate-200"><Objeto id="neurona-dragopavo" /></span>
                <span class="px-2 py-1 rounded-lg bg-slate-50 border border-slate-200"><Objeto id="ambar-mulagua" /></span>
                <span class="px-2 py-1 rounded-lg bg-slate-50 border border-slate-200"><Objeto id="cuerno-vueloceronte" /></span>
              </div>
            </li>
            <li class="p-3 rounded-xl border border-slate-200"><span class="font-bold text-slate-900">Vender o equipar:</span> venderlas en el mercadillo, mejor tras subirles algo de nivel, o equiparlas.</li>
          </ul>
        </GuideSection>

        <GuideSection id="experiencia" eyebrow="Cómo se cría · Paso 6" title="Sube de nivel tus monturas">
          <p class={p}>
            La experiencia solo se gana en el cercado con el medidor de experiencia. Hacen falta <strong>172.668</strong> puntos para el nivel 100 y
            <strong>867.582</strong> para el 200. Con el tramo 4 siempre lleno, una montura gana 4 por segundo: unas 12 h al 100 y unas 60 h al 200.
            Con el tramo 2, el doble de tiempo. En la práctica <mark class="resaltado">cuenta con 100 a 150 horas hasta el 200</mark>, la mitad si es Sabia.
          </p>
          <ToolLink href="/calculadora" label="Calculadora">Elige una montura de tu establo y te dice cuánto carburante y cuánto tiempo le faltan.</ToolLink>
        </GuideSection>

        <GuideSection id="recompensas" title="Recompensas">
          <p class={p}>
            Las <Objeto id="geneticha">genetichas</Objeto> son fichas de cuenta que ganas cuando el bebé supera en generación a todas las monturas del árbol de sus
            padres. Recibes, por cada padre, según su generación: 2, 4, 8, 16, 30, 60, 120, 240 y 500 genetichas de la generación 1 a
            la 9. <strong>Un padre de generación 9 y otro de 1 dan 502.</strong> Eugen Eticha las cambia por pergaminos de características, turmalinas,
            alichas y apariencias Camaleón.
          </p>
          <p class={p}><mark class="resaltado">El día 10 de cada mes</mark> el Almanax da un bonus de crianza:</p>
          <div class="almanax">
            <GuideTable caption="Bonus de crianza del Almanax" head={['Fecha', 'Bonus']} rows={almanax} rowData={almanaxMonths} />
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center gap-3 p-3.5 rounded-xl border border-blue-200/80 bg-blue-50/70 text-blue-950">
            <div class="flex-shrink-0 w-11 rounded-md overflow-hidden border border-blue-900/20 text-center bg-white" aria-hidden="true">
              <div class="bg-blue-800 text-white text-[10px] font-bold leading-4">día</div>
              <div class="text-lg font-black text-slate-900 leading-7">10</div>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-[13px] font-extrabold text-blue-950">Añade el Almanax a tu calendario</p>
              <p class="text-[12px] leading-snug text-blue-900/80">
                Te avisa la víspera a las 20:00 y el mismo día a las 08:00. Además, la web te muestra un aviso arriba esos dos días.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-2 sm:flex-shrink-0">
              <a
                href={icsPath}
                download="almanax-crianza.ics"
                class="inline-flex justify-center items-center min-h-[40px] px-3.5 rounded-xl bg-blue-800 text-white text-[13px] font-bold hover:bg-blue-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
              >Descargar calendario</a>
              <a
                href={googleCalendarUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex justify-center items-center min-h-[40px] px-3.5 rounded-xl bg-white border border-blue-200 text-blue-900 text-[13px] font-bold hover:bg-blue-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
              >Google Calendar</a>
            </div>
          </div>
          <p class="text-[11px] text-slate-500 -mt-1">
            El archivo funciona en el calendario del móvil, Apple Calendar y Outlook. En Google Calendar los avisos siguen tu propia
            configuración de notificaciones.
          </p>
        </GuideSection>

        <GuideSection id="consejos" title="Consejos para empezar">
          <ul class="space-y-2 text-sm leading-relaxed">
            <li class="flex gap-2.5"><span class="text-blue-600 font-bold" aria-hidden="true">•</span><span><strong>Captura mucho y en grupo.</strong> Una pareja nunca da más de dos monturas, así que la crianza no se sostiene sola; sube la prospección para conseguir más recursos al extraer.</span></li>
            <li class="flex gap-2.5"><span class="text-blue-600 font-bold" aria-hidden="true">•</span><span><strong>Sube el oficio cuanto antes.</strong> Con nivel 120 ya tienes cuatro cercados, y fabricar carburantes te da experiencia y combustible a la vez.</span></li>
            <li class="flex gap-2.5"><span class="text-blue-600 font-bold" aria-hidden="true">•</span><span><strong>Agrupa por serenidad:</strong> un cercado para las de −2.000 a −1 (aguante y madurez), otro para las de 0 a 2.000 (amor y madurez) y otros para corregir las que están en los extremos.</span></li>
            <li class="flex gap-2.5"><span class="text-blue-600 font-bold" aria-hidden="true">•</span><span>Si un cercado solo tiene un medidor activo, enciende también el de experiencia.</span></li>
            <li class="flex gap-2.5"><span class="text-blue-600 font-bold" aria-hidden="true">•</span><span>Usa Optimákina en las generaciones altas y clona en vez de vender si vas a por los logros.</span></li>
          </ul>
          <p class={p}>
            Los logros piden capturar cada tipo salvaje (3 dragopavos, 5 mulaguas, 4 vuelocerontes), hacer nacer 1.000 monturas y
            obtener todas las generaciones de la 2 a la 10 de los tres tipos, lo que lleva meses.
          </p>
        </GuideSection>
        <p class="px-1 text-[11px] text-slate-500">
          Basada en las guías de
          <a href="https://www.dofuspourlesnoobs.com/guide-de-l-eleveur.html" target="_blank" rel="noopener" class="underline decoration-slate-600 underline-offset-2 hover:text-slate-300">Dofus pour les Noobs</a>.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .guide-section p,
  .guide-section li {
    text-wrap: pretty;
  }
  .guide-section h2,
  .guide-section h3 {
    text-wrap: balance;
  }
  .toc-link[aria-current='true'] {
    color: #2a450d;
    background-color: #dfedbd;
    font-weight: 700;
    box-shadow: inset 3px 0 0 #4a7a12;
  }
  /* Sendero punteado que une los sellos de la ruta rápida */
  .ruta::before {
    content: '';
    position: absolute;
    top: 19px;
    left: 10%;
    right: 10%;
    border-top: 3px dashed #c4ac80;
  }
  @media (min-width: 640px) {
    .ruta::before {
      top: 21px;
    }
  }
  .almanax tr[data-current='true'] th,
  .almanax tr[data-current='true'] td {
    background-color: #fffbeb;
  }
  .almanax tr[data-today='true'] th::after {
    content: ' · hoy' !important;
  }
  .almanax tr[data-current='true'] th::after {
    content: ' · próximo';
    color: #b45309;
    font-weight: 700;
  }
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  // Índice: marca la sección que se está leyendo
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => links.set(a.dataset.tocLink!, a));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.guide-section'));
  const visible = new Set<string>();
  const update = () => {
    const current = sections.find((s) => visible.has(s.id));
    links.forEach((a, id) => a.setAttribute('aria-current', String(id === current?.id)));
  };
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
      update();
    },
    { rootMargin: '-15% 0px -70% 0px' }
  );
  sections.forEach((s) => io.observe(s));

  // Índice móvil: se cierra al elegir una sección
  document.querySelectorAll<HTMLDetailsElement>('details.toc').forEach((d) =>
    d.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (d.open = false)))
  );

  // Almanax: resalta el próximo bonus (hoy incluido); las fechas pasadas no se marcan
  const param = new URLSearchParams(location.search).get('fecha');
  const now = param && /^\d{4}-\d{2}-\d{2}$/.test(param) ? new Date(`${param}T12:00:00`) : new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  let next: { tr: HTMLElement; date: Date } | null = null;
  document.querySelectorAll<HTMLElement>('.almanax tr[data-row]').forEach((tr) => {
    const parts = (tr.dataset.row ?? '').split('-').map(Number);
    const [y, m, d] = parts.length === 3 ? parts : [today.getFullYear(), parts[0], parts[1]];
    let date = new Date(y, m - 1, d);
    // Los bonus anuales ya pasados este año cuentan para el año siguiente
    if (parts.length === 2 && date < today) date = new Date(y + 1, m - 1, d);
    if (date >= today && (!next || date < next.date)) next = { tr, date };
  });
  if (next) {
    const { tr, date } = next as { tr: HTMLElement; date: Date };
    tr.dataset.current = 'true';
    if (date.getTime() === today.getTime()) tr.dataset.today = 'true';
  }
</script>
